# Copy this file to ".env" (same folder) and fill it in. Never commit .env.
# Start the site with:  npm start   (NOT "python -m http.server" — that has no
# forms API and exposes every file in the folder).

NODE_ENV=development          # set to "production" on the live host
PORT=4173

# Set to 1 ONLY when running behind a proxy you control (Cloudflare, Render,
# Fly, nginx). It makes rate limiting use the real visitor IP.
TRUST_PROXY=0
IP_HASH_SALT=change-me-to-a-long-random-string

# Where the leads database lives. Default: ./data/steven_lenz.db (outside the
# public site folder). On a host, point this at a persistent disk.
# DB_PATH=/var/data/steven_lenz.db

# --- Notifications (all optional; leads are always saved to the DB first) ---

# 1) Email via Resend (https://resend.com). Needs a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Steven Lenz Jr. <hello@yourdomain.com>"
LEAD_NOTIFY_EMAIL=            # where new-lead alerts go (Steven's inbox)
LEAD_AUTO_ACK=1               # 1 = also email the visitor a thank-you; 0 = off

# 2) AI desk (OpenMausBot Follow-Up Concierge) webhook
OMB_LEAD_WEBHOOK_URL=
OMB_LEAD_WEBHOOK_TOKEN=

# 3) Google Sheets / Zapier / Make webhook (receives the lead as JSON)
LEAD_PERSIST_WEBHOOK_URL=
